# setuptools-scm will write this file for us during installation; do not
# version control it:
pyDFCSR_2D/_version.py

# Simulation outputs (HDF5 particle/wake dumps) -- reproducible, large
pyDFCSR_2D/example/output/

# Artifact of a script that ran with the wrong cwd, creating a nested duplicate path
pyDFCSR_2D/pyDFCSR_2D/

# Input decks auto-generated by the diagnostic scripts in pyDFCSR_2D/test/.
# Each test's write_inputs() rewrites these on every run, so tracking them means
# permanent churn. They are reproducible by running the corresponding test.
pyDFCSR_2D/example/input/anat_*
pyDFCSR_2D/example/input/bf_*
pyDFCSR_2D/example/input/cmp_*
pyDFCSR_2D/example/input/cmv_*
pyDFCSR_2D/example/input/eq424_*
